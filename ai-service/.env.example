# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5000,http://localhost:5173

# Hugging Face Transformer Models
HF_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
HF_CLASSIFICATION_MODEL=typeform/distilbert-base-uncased-mnli

# GPT-OSS-20B Serving Endpoint (Ollama / vLLM / TGI / OpenAI-compatible)
# Example local Ollama: http://localhost:11434/v1
# Example OpenAI / cloud: https://api.openai.com/v1
# If endpoint is unreachable or empty, deterministic resolution templates automatically activate
GPT_OSS_BASE_URL=
GPT_OSS_MODEL=gpt-oss-20b
GPT_OSS_API_KEY=

# Google Gemini Voice / STT Configuration
# Free/Pro API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_MODEL=gemini-3.6-flash
